<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>ACCESS REQUIRED — Metehan İlter</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{--bg:#050B12;--panel:#0A1622;--border:#15314A;--green:#22D3A7;--cyan:#4CC9F0;
        --red:#FF5F56;--amber:#FFBD2E;--txt:#C8E6DA;--mut:#5E7A8C;--bright:#A6FFE3}
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{font-family:'JetBrains Mono',Consolas,monospace;background:var(--bg);color:var(--txt);
       display:flex;align-items:center;justify-content:center;padding:20px;overflow:hidden}
  body::after{content:"";position:fixed;inset:0;pointer-events:none;
    background:repeating-linear-gradient(0deg, rgba(0,0,0,.13) 0 1px, transparent 1px 3px)}
  #matrix{position:fixed;inset:0;z-index:0;opacity:.22;pointer-events:none}
  .lock{position:relative;z-index:1;width:100%;max-width:480px;background:var(--panel);
        border:1px solid var(--border);border-radius:10px;overflow:hidden;
        box-shadow:0 0 60px rgba(34,211,167,.15)}
  .bar{display:flex;align-items:center;gap:6px;background:#0D1D2E;padding:10px 14px;
       border-bottom:1px solid var(--border)}
  .dot{width:10px;height:10px;border-radius:50%}
  .d1{background:#FF5F56}.d2{background:#FFBD2E}.d3{background:#27C93F}
  .bar span{margin-left:8px;color:var(--mut);font-size:11px}
  .body{padding:26px 26px 30px;text-align:center}
  .shield{font-size:38px;margin-bottom:10px;filter:drop-shadow(0 0 12px rgba(34,211,167,.5))}
  h1{font-size:15px;letter-spacing:2px;color:var(--bright);margin-bottom:4px}
  .sub{color:var(--mut);font-size:11.5px;margin-bottom:22px;line-height:1.6}
  .sub b{color:var(--green)}
  .inwrap{display:flex;gap:8px}
  input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:6px;
        color:var(--bright);font-family:inherit;font-size:14px;padding:11px 13px;
        outline:none;letter-spacing:2px;caret-color:var(--green)}
  input:focus{border-color:var(--green);box-shadow:0 0 0 2px rgba(34,211,167,.18)}
  button{background:var(--green);color:var(--bg);border:none;border-radius:6px;
         font-family:inherit;font-weight:700;font-size:13px;padding:0 20px;cursor:pointer}
  button:hover{filter:brightness(1.1)}
  button:disabled{opacity:.5;cursor:wait}
  .msg{margin-top:14px;font-size:12px;min-height:18px}
  .msg.err{color:var(--red)}
  .msg.ok{color:var(--green)}
  .msg.busy{color:var(--amber)}
  .foot{color:var(--mut);font-size:10px;margin-top:20px}
  .shake{animation:shake .4s}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-7px)}
                   50%{transform:translateX(7px)}75%{transform:translateX(-4px)}}
  @media (prefers-reduced-motion: reduce){.shake{animation:none}}
</style>
</head>
<body>
<canvas id="matrix" aria-hidden="true"></canvas>
<div class="lock" id="lockbox">
  <div class="bar">
    <span class="dot d1"></span><span class="dot d2"></span><span class="dot d3"></span>
    <span>vault://metehan-ilter/cv — AES-256-GCM</span>
  </div>
  <div class="body">
    <div class="shield">🔐</div>
    <h1>ACCESS REQUIRED</h1>
    <p class="sub">Bu CV şifre korumalıdır. / This CV is password-protected.<br>
       Erişim şifresini girin: / Enter the access key:</p>
    <div class="inwrap">
      <input id="pw" type="password" autocomplete="off" autofocus
             placeholder="••••••••" aria-label="Şifre / Password">
      <button id="go">UNLOCK</button>
    </div>
    <div class="msg" id="msg"></div>
    <p class="foot">© Metehan İlter — yetkisiz erişim denemeleri loglanıyor olabilir 😉</p>
  </div>
</div>

<script>
const P = {"salt": "+EJicYjpQ1b21WVEU7J/yA==", "iv": "PrgfxQFvqzqHyn2q", "iter": 310000, "ct": ""};
const $ = s => document.querySelector(s);
const b64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));

async function unlock(){
  const pw = $("#pw").value;
  if(!pw) return;
  const btn = $("#go"), msg = $("#msg");
  btn.disabled = true;
  msg.className = "msg busy";
  msg.textContent = "[*] anahtar türetiliyor / deriving key...";
  await new Promise(r => setTimeout(r, 30));
  try{
    const keyMat = await crypto.subtle.importKey("raw",
      new TextEncoder().encode(pw), "PBKDF2", false, ["deriveKey"]);
    const key = await crypto.subtle.deriveKey(
      {name:"PBKDF2", salt:b64(P.salt), iterations:P.iter, hash:"SHA-256"},
      keyMat, {name:"AES-GCM", length:256}, false, ["decrypt"]);
    msg.textContent = "[*] içerik çözülüyor / decrypting...";
    const pt = await crypto.subtle.decrypt(
      {name:"AES-GCM", iv:b64(P.iv)}, key, b64(P.ct));
    msg.className = "msg ok";
    msg.textContent = "[+] ACCESS GRANTED ✔";
    setTimeout(()=>{
      const html = new TextDecoder().decode(pt);
      document.open(); document.write(html); document.close();
    }, 450);
  }catch(e){
    btn.disabled = false;
    msg.className = "msg err";
    msg.textContent = "[-] ACCESS DENIED — hatalı şifre / wrong key";
    const box = $("#lockbox");
    box.classList.remove("shake"); void box.offsetWidth; box.classList.add("shake");
    $("#pw").value = ""; $("#pw").focus();
  }
}
$("#go").addEventListener("click", unlock);
$("#pw").addEventListener("keydown", e => { if(e.key === "Enter") unlock(); });

/* subtle matrix rain on the lock screen */
(function(){
  if(window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const c = $("#matrix"), x = c.getContext("2d");
  const CH = "01<>/{}#$";
  let cols = [], fs = 14;
  function rs(){ c.width = innerWidth; c.height = innerHeight;
    cols = Array.from({length: Math.floor(c.width/fs)},
      ()=>({y: Math.random()*c.height/fs, s:.25+Math.random()*.5})); }
  rs(); addEventListener("resize", rs);
  (function d(){
    x.fillStyle = "rgba(5,11,18,0.12)"; x.fillRect(0,0,c.width,c.height);
    x.font = fs + "px 'JetBrains Mono',monospace";
    cols.forEach((co,i)=>{
      x.fillStyle = Math.random()<.5 ? "#147A60" : "#0E5A47";
      x.fillText(CH[Math.floor(Math.random()*CH.length)], i*fs, co.y*fs);
      co.y += co.s;
      if(co.y*fs > c.height && Math.random() > .98) co.y = 0;
    });
    requestAnimationFrame(d);
  })();
})();
</script>
</body>
</html>
